# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=homepage
DB_PASSWORD=
DB_NAME=homepage

# ===== 连接池 =====
DB_POOL_SIZE=10

# ===== API 服务 =====
PORT=3900
NODE_ENV=production

# ===== CORS =====
# 逗号分隔，支持通配符
CORS_ORIGINS=*.insai.cn,*.yingsaidata.com

# ===== 限频 =====
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
